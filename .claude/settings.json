{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git blame:*)",
      "Bash(git remote -v)",
      "Bash(git stash list)",

      "Bash(node -v)",
      "Bash(node --version)",
      "Bash(npm -v)",
      "Bash(npm --version)",
      "Bash(npm ls:*)",
      "Bash(npm outdated:*)",

      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run dev:turbo:*)",

      "Bash(python --version)",
      "Bash(python3 --version)",
      "Bash(pip show:*)",
      "Bash(pip list:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(gsudo:*)",
      "Bash(runas:*)",

      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(del:*)",
      "Bash(rd:*)",
      "Bash(shred:*)",

      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git checkout -- .)",
      "Bash(git restore .)",
      "Bash(git branch -D:*)",
      "Bash(git rebase:*)",

      "Bash(curl *|*)",
      "Bash(wget *|*)",
      "Bash(iwr *|*)",
      "Bash(iex:*)",

      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(format:*)",
      "Bash(diskpart:*)",
      "Bash(powershell -Command *Remove-Item*)",

      "Bash(npm publish:*)",
      "Bash(npm run migrate:*)",
      "Bash(npm run undo-migrate:*)",
      "Bash(sequelize db:migrate:*)",
      "Bash(sequelize db:migrate:undo:*)",
      "Bash(sequelize db:drop:*)",

      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/ .env)",
      "Read(./**/ .env.*)"
    ]
  }
}